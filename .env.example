# Base URL of the iris-backend REST API.
#
# The `/v1` is required and is not a typo: the Nest app uses URI versioning
# with `defaultVersion: '1'`, and its controllers are declared
# `@Controller('api/...')` — so the real paths are `/v1/api/auth/signin` and
# friends. Sending to `/api/...` instead is answered by the Swagger basic-auth
# middleware (mounted on `/api` in main.ts) with a 401, never by the controller.
#
# In development leave this as `/v1/api` and let the Vite dev proxy
# (see `server.proxy` in vite.config.ts) forward to the Nest server — that
# keeps requests same-origin so CORS never applies. Point VITE_PROXY_TARGET at
# the backend if it is not on http://localhost:5000.
#
# In a deployed build set the full origin, e.g. https://api.example.com/v1/api
VITE_API_URL=/v1/api

# Where the dev proxy forwards /v1. Development only.
VITE_PROXY_TARGET=http://localhost:5000

# "false" disables the MSW mock API so the app talks to a real backend.
# Ignored outside development.
VITE_ENABLE_MOCKS=true
